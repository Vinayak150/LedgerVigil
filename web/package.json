{
  "name": "ledgervigil-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi.json -o src/lib/api.generated.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.mjs",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "tailwindcss": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "prettier": "3.9.10"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": "11.0.1"
    }
  }
}
