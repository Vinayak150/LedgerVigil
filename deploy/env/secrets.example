# Files to create under deploy/secrets/ on the target host (never commit them). One value per file, no trailing comments.
# Generate each password with: python3 -c "import secrets;print(secrets.token_hex(32))"
#
# pg_superuser_password                      PostgreSQL superuser (db service only)
# migrator_dsn      postgresql://lv_migrator:<password>@db:5432/ledgervigil        (migrate, readiness)
# app_dsn           postgresql://lv_app:<password>@db:5432/ledgervigil             (api)
# worker_dsn        postgresql://lv_worker:<password>@db:5432/ledgervigil          (maintenance, provider-worker, scheduler)
# cursor_key        64+ hexadecimal characters                                     (api)
# provider/api/api.env, provider/api/kek-public.pem                                (api; from tools.provider_setup --container)
# provider/worker/worker.env, kek-private.pem, kek-public.pem                      (provider-worker only)
#
# One-time `prepare` run only (remove afterwards):
# superuser_dsn     postgresql://postgres:<password>@db:5432/ledgervigil
# roles/lv_migrator, roles/lv_app, roles/lv_seed, roles/lv_ingest, roles/lv_worker   one password per file
