# Frontend. Next.js serializes rewrites at build time; bake the internal API service address.
FROM node:22-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web ./
ARG LV_API_ORIGIN=http://api:8000
ENV LV_API_ORIGIN=$LV_API_ORIGIN
RUN npm run build
FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /web
COPY --from=build /web/package.json /web/package-lock.json ./
COPY --from=build /web/node_modules ./node_modules
COPY --from=build /web/.next ./.next
COPY --from=build /web/next.config.ts ./next.config.ts
RUN groupadd -g 10002 lvweb && useradd -u 10002 -g 10002 -M -s /usr/sbin/nologin lvweb
USER 10002:10002
EXPOSE 3000
CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
